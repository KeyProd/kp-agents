#!/usr/bin/env bash
set -euo pipefail

# ─────────────────────────────────────────────────────────────
# pre-commit — kp-agents
#
# Si le commit modifie le contenu d'un skill, exige que la version du
# plugin concerné ait été montée à la main (vs HEAD) :
#   kp-agents    : claude/skills/, codex/, cursor/ → .claude-plugin/plugin.json
#   jpb-platform : jpb-platform/{skills,codex,scripts}/ → jpb-platform/.claude-plugin/plugin.json
#
# Activation : git config core.hooksPath .githooks  (fait par ./sync.sh)
# Contournement ponctuel : git commit --no-verify
# ─────────────────────────────────────────────────────────────

RED='\033[0;31m'; YELLOW='\033[0;33m'; GREEN='\033[0;32m'; NC='\033[0m'

read_version() {
    # $1 = ref-spec git (ex: ":chemin"=index, "HEAD:chemin")
    git show "$1" 2>/dev/null | python3 -c \
        'import sys,json; print(json.load(sys.stdin).get("version",""))' 2>/dev/null || true
}

# check_bump <plugin.json> <regex des chemins de contenu du plugin>
# Échoue si un fichier de contenu du plugin est staged sans bump de sa version.
check_bump() {
    local plugin_json="$1" pattern="$2"
    local changes staged_version head_version
    changes="$(git diff --cached --name-only --diff-filter=ACMRD | grep -E "$pattern" || true)"
    [[ -z "$changes" ]] && return 0

    staged_version="$(read_version ":$plugin_json")"
    head_version="$(read_version "HEAD:$plugin_json")"
    # Pas de version côté HEAD (premier commit / plugin nouveau) → rien à comparer.
    [[ -z "$head_version" ]] && return 0

    if [[ -z "$staged_version" ]]; then
        echo -e "${RED}✗ pre-commit : impossible de lire la version dans $plugin_json${NC}" >&2
        return 1
    fi
    if [[ "$staged_version" == "$head_version" ]]; then
        echo -e "${RED}✗ pre-commit : un skill a changé mais la version n'a pas été montée.${NC}" >&2
        echo -e "  Version actuelle : ${YELLOW}$head_version${NC}" >&2
        echo -e "  Monte la version dans ${YELLOW}$plugin_json${NC} (et CHANGELOG.md) avant de committer." >&2
        echo "" >&2
        echo "  Skills modifiés :" >&2
        echo "$changes" | sed 's/^/    /' >&2
        echo "" >&2
        echo -e "  Contournement ponctuel : ${YELLOW}git commit --no-verify${NC}" >&2
        return 1
    fi
    echo -e "${GREEN}✓ pre-commit : $plugin_json — version montée $head_version → $staged_version${NC}"
}

status=0
check_bump ".claude-plugin/plugin.json" '^(claude/skills/|codex/|cursor/)' || status=1
check_bump "jpb-platform/.claude-plugin/plugin.json" '^jpb-platform/(skills|codex|scripts)/' || status=1
exit $status
